{
 "_comment": "Plan de pxd_updater: qué recursos nuevos arranca solo (en este orden), a cuáles sustituyen y qué ajustes hace en recursos de terceros. Solo se publica lo que existe en el repo.",
 "autostart": [
  "pxd_progress",
  "pxd_restart",
  "pxd_jobs",
  "pxd_panel",
  "pxd_multichar",
  "pxd_hud",
  "pxd_inventory"
 ],
 "replaces": {
  "pxd_hud": [
   "qbx_hud"
  ]
 },
 "patches": [
  {
   "resource": "qbx_core",
   "path": "config/client.lua",
   "find": "useExternalCharacters = false",
   "replace": "useExternalCharacters = true",
   "requires": "pxd_multichar",
   "why": "pantalla de personajes de Próxima"
  },
  {
   "resource": "npwd",
   "path": "config.json",
   "find": "\"defaultLanguage\": \"en\"",
   "replace": "\"defaultLanguage\": \"es\"",
   "requires": "pxd_hud",
   "why": "teléfono en español"
  },
  {
   "resource": "ox_inventory",
   "path": "web/build/index.html",
   "find": "</head>",
   "replace": "<link rel=\"stylesheet\" href=\"./assets/pxd.css\"><script src=\"./assets/pxd.js\"></script></head>",
   "requires": "pxd_inventory",
   "why": "inventario con el estilo de Próxima"
  }
 ],
 "_comment_overlays": "Archivos de pxd_* que se copian a recursos de terceros (solo con la versión indicada). Requieren add_filesystem_permission pxd_updater write <recurso> y reiniciar el servidor.",
 "overlays": [
  {
   "resource": "ox_inventory",
   "requiresVersion": "2.48.1",
   "path": "web/build/assets/pxd.css",
   "from": "pxd_inventory/overlay/ox_inventory/pxd.css"
  },
  {
   "resource": "ox_inventory",
   "requiresVersion": "2.48.1",
   "path": "web/build/assets/pxd.js",
   "from": "pxd_inventory/overlay/ox_inventory/pxd.js"
  }
 ]
}
