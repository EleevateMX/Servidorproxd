{
  "name": "pxd-orgs-ui",
  "private": true,
  "description": "Próxima RP — interfaz de pxd_orgs (organizaciones: miembros, fondos, identidad, invitaciones y solicitudes)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fonts": "node scripts/fonts.mjs",
    "build": "tsc --noEmit && node scripts/fonts.mjs && vite build && node scripts/source-hash.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@fontsource/bangers": "5.1.0",
    "@fontsource/bebas-neue": "5.1.0",
    "@fontsource/black-ops-one": "5.1.0",
    "@fontsource/pacifico": "5.1.0",
    "@fontsource/permanent-marker": "5.1.0",
    "@fontsource/russo-one": "5.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
