# Bot de Discord de Próxima RP. Copia este archivo a discord/.env y rellénalo.
# discord/.env está en .gitignore: nunca lo subas.

# Portal de desarrolladores de Discord → tu aplicación → Bot → Reset Token.
DISCORD_TOKEN=
# Clic derecho en el servidor → Copiar ID del servidor (modo desarrollador activado).
DISCORD_GUILD_ID=

# Servidor de FiveM para el contador de jugadores (puerto del juego, normalmente 30120).
# Con el docker-compose de deploy/: http://fxserver:30120
FIVEM_URL=
# Dirección para `connect` en F8 (la que da el panel del hosting), p. ej. 123.45.67.89:30120
FIVEM_CONNECT=
# Enlace https para entrar con un clic (portal de Cfx.re), p. ej. https://cfx.re/join/xxxxxx
FIVEM_JOIN_URL=

# Minutos entre actualizaciones de los contadores (mínimo 10, límite de Discord).
STATS_INTERVAL_MIN=10

# Enlaces oficiales para #enlaces (solo https; vacíos = no se muestran).
LINK_DISCORD=https://discord.gg/qUcD5gCf6v
LINK_WEB=
LINK_STORE=
LINK_INSTAGRAM=
LINK_TIKTOK=
LINK_YOUTUBE=
