# Copia este archivo a secrets.cfg (los scripts de setup lo hacen por ti).
# secrets.cfg está en .gitignore: NUNCA lo subas a git.

# Clave de licencia del servidor: https://portal.cfx.re (gratis).
sv_licenseKey "PEGA_AQUI_TU_LICENCIA"

# Modo LAN: sin licencia y sin aparecer en la lista pública. Ideal para probar solo
# en tu PC o tu red local. Quítalo (o ponlo en false) para que entren amigos por internet.
sv_lan true

# Dashboard web de props (http://IP:30120/pxd_props/) y comando pxd.
# Mínimo 24 caracteres. Usa `set`, NUNCA `setr` (setr lo enviaría a los jugadores).
set pxd_props_webToken "GENERA_UN_TOKEN_LARGO"

# Código de acceso al conectar (opcional). Vacío = sin código.
set pxd_login_accessCode ""

# Si añades Qbox/oxmysql más adelante (docker compose up -d):
#set mysql_connection_string "mysql://proxima:CONTRASENA@127.0.0.1:3306/proxima?charset=utf8mb4"

# Tienda Tebex (opcional): clave secreta de Integrations → Game Servers en creator.tebex.io.
#sv_tebexSecret "PEGA_AQUI_TU_CLAVE_DE_TEBEX"
